{
  "info": {
    "name": "ProyectoBd2 - Parte 3",
    "description": "Colección para probar estado de viaje, tarifas y pagos en el backend de Uber TPO.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "trip_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Registrar pasajero",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan.perez@example.com\",\n  \"telefono\": \"+541112345678\",\n  \"contrasena\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register/usuario",
          "host": ["{{base_url}}"],
          "path": ["auth", "register", "usuario"]
        }
      }
    },
    {
      "name": "Registrar conductor",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"María Gómez\",\n  \"email\": \"maria.gomez@example.com\",\n  \"telefono\": \"+541198765432\",\n  \"contrasena\": \"Password123\",\n  \"nro_licencia\": \"ABC123456\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/register/conductor",
          "host": ["{{base_url}}"],
          "path": ["auth", "register", "conductor"]
        }
      }
    },
    {
      "name": "Login usuario/conductor",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"contrasena\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.access_token) {",
              "  pm.collectionVariables.set('auth_token', response.access_token);",
              "  console.log('Bearer token set from login');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Obtener estado de viaje",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/trips/{{trip_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["trips", "{{trip_id}}", "status"]
        }
      }
    },
    {
      "name": "Actualizar estado de viaje",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado\": \"aceptado\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/trips/{{trip_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["trips", "{{trip_id}}", "status"]
        }
      }
    },
    {
      "name": "Obtener tarifa del viaje",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/trips/{{trip_id}}/fare",
          "host": ["{{base_url}}"],
          "path": ["trips", "{{trip_id}}", "fare"]
        }
      }
    },
    {
      "name": "Crear pago",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_viaje\": {{trip_id}},\n  \"monto_base\": 1200.00,\n  \"tarifa_adicional\": 150.00,\n  \"metodo_pago\": \"tarjeta_credito\",\n  \"estado_transaccion\": \"pendiente\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments",
          "host": ["{{base_url}}"],
          "path": ["payments"]
        }
      }
    },
    {
      "name": "Obtener pago por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/payments/{{payment_id}}",
          "host": ["{{base_url}}"],
          "path": ["payments", "{{payment_id}}"]
        }
      }
    },
    {
      "name": "Actualizar estado de pago",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_transaccion\": \"aprobado\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/{{payment_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["payments", "{{payment_id}}", "status"]
        }
      }
    }
  ]
}
