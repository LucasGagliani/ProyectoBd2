{
  "info": {
    "name": "ProyectoBd2 - Parte 4",
    "description": "Colección para probar historial de viajes, reseñas mutuas y flujo de pago post-viaje.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "trip_id",
      "value": "1",
      "type": "string"
    },
    {
      "key": "payment_id",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/",
          "host": ["{{base_url}}"],
          "path": [""]
        }
      }
    },
    {
      "name": "Login pasajero",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"juan.perez@example.com\",\n  \"contrasena\": \"Password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "if (response.access_token) {",
              "  pm.collectionVariables.set('auth_token', response.access_token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "Historial de viajes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/trips/history",
          "host": ["{{base_url}}"],
          "path": ["trips", "history"]
        }
      }
    },
    {
      "name": "Crear pago (solo pasajero)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_viaje\": {{trip_id}},\n  \"monto_base\": 1200.00,\n  \"tarifa_adicional\": 0.00,\n  \"metodo_pago\": \"efectivo\",\n  \"estado_transaccion\": \"pendiente\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments",
          "host": ["{{base_url}}"],
          "path": ["payments"]
        }
      }
    },
    {
      "name": "Confirmar pago (solo conductor)",
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estado_transaccion\": \"aprobado\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/payments/{{payment_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["payments", "{{payment_id}}", "status"]
        }
      }
    },
    {
      "name": "Estado de reseñas del viaje",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/reviews/trip/{{trip_id}}/status",
          "host": ["{{base_url}}"],
          "path": ["reviews", "trip", "{{trip_id}}", "status"]
        }
      }
    },
    {
      "name": "Crear reseña (pasajero → conductor)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id_viaje\": {{trip_id}},\n  \"calificacion\": 5,\n  \"comentario\": \"Excelente viaje, muy puntual.\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/reviews",
          "host": ["{{base_url}}"],
          "path": ["reviews"]
        }
      }
    },
    {
      "name": "Listar reseñas del viaje",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/reviews/trip/{{trip_id}}",
          "host": ["{{base_url}}"],
          "path": ["reviews", "trip", "{{trip_id}}"]
        }
      }
    }
  ]
}
