# SQL Database
SQL_HOST=localhost
SQL_PORT=5432
SQL_USER=postgres
SQL_PASSWORD=password
SQL_DATABASE=uber_tpo
SQL_SSLMODE=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# MongoDB
MONGODB_URI=
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_USER=
MONGODB_PASSWORD=
MONGODB_DATABASE=uber_tpo

# Neo4j
# Usar neo4j+s:// para Aura con certificado valido.
# Usar neo4j+ssc:// si Python rechaza la cadena SSL localmente.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_HOST=localhost
NEO4J_PORT=7687

# Cassandra local
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=uber
CASSANDRA_USER=
CASSANDRA_PASSWORD=

# Astra DB (opcional, reemplaza Cassandra local si se completa)
ASTRA_TOKEN=
ASTRA_API_ENDPOINT=
ASTRA_KEYSPACE=uber

# JWT
JWT_SECRET_KEY=changeme-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
